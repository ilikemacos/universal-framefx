<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>UniversalFrameFX.PresetAi</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Models\preset_r3.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\preset_r3.onnx.data" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\preset_g14.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Models\preset_g14.onnx.data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std140, binding = 0) uniform SpatialUniforms {
    vec2 inputSize;
    vec2 outputSize;
    vec2 invInputSize;
    vec2 scale;
    float sharpness;
    float _pad0;
    vec2 _pad1;
} u;

layout(binding = 1) uniform sampler2D src;
layout(binding = 2, rgba32f) uniform writeonly image2D dst;

float edgeLuma(vec3 c) {
    return c.g + 0.5 * (c.r + c.b);
}

float saturate(float x) { return clamp(x, 0.0, 1.0); }

float safeRcp(float x) {
    return x == 0.0 ? 0.0 : 1.0 / x;
}

void easuSet(inout vec2 dir, inout float len, vec2 pp, int corner,
             float lA, float lB, float lC, float lD, float lE) {
    float w = 0.0;
    if (corner == 0)      w = (1.0 - pp.x) * (1.0 - pp.y);
    else if (corner == 1) w = pp.x * (1.0 - pp.y);
    else if (corner == 2) w = (1.0 - pp.x) * pp.y;
    else                  w = pp.x * pp.y;

    float dc   = lD - lC;
    float cb   = lC - lB;
    float lenX = safeRcp(max(abs(dc), abs(cb)));
    float dirX = lD - lB;
    dir.x += dirX * w;
    lenX   = saturate(abs(dirX) * lenX);
    len   += lenX * lenX * w;

    float ec   = lE - lC;
    float ca   = lC - lA;
    float lenY = safeRcp(max(abs(ec), abs(ca)));
    float dirY = lE - lA;
    dir.y += dirY * w;
    lenY   = saturate(abs(dirY) * lenY);
    len   += lenY * lenY * w;
}

void easuTap(inout vec3 accColor, inout float accWeight, vec2 off, vec2 dir,
             vec2 len2, float lob, float clp, vec3 c) {
    vec2 v;
    v.x = (off.x *  dir.x) + (off.y * dir.y);
    v.y = (off.x * -dir.y) + (off.y * dir.x);
    v *= len2;

    float d2 = min(v.x * v.x + v.y * v.y, clp);

    float wB = (2.0 / 5.0) * d2 - 1.0;
    float wA = lob * d2 - 1.0;
    wB *= wB;
    wA *= wA;
    wB = (25.0 / 16.0) * wB - (25.0 / 16.0 - 1.0);
    float w = wB * wA;

    accColor  += c * w;
    accWeight += w;
}

vec3 tap(ivec2 fp, int dx, int dy) {
    ivec2 ts = textureSize(src, 0) - ivec2(1);
    ivec2 c = clamp(fp + ivec2(dx, dy), ivec2(0), ts);
    return texelFetch(src, c, 0).rgb;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= uint(u.outputSize.x) || gid.y >= uint(u.outputSize.y)) {
        return;
    }

    vec2 pp = (vec2(gid) + 0.5) * u.scale - 0.5;
    vec2 fp2 = floor(pp);
    pp -= fp2;
    ivec2 fp = ivec2(fp2);

    vec3 bC = tap(fp,  0, -1), cC = tap(fp,  1, -1);
    vec3 eC = tap(fp, -1,  0), fC = tap(fp,  0,  0), gC = tap(fp,  1,  0), hC = tap(fp,  2,  0);
    vec3 iC = tap(fp, -1,  1), jC = tap(fp,  0,  1), kC = tap(fp,  1,  1), lC = tap(fp,  2,  1);
    vec3 nC = tap(fp,  0,  2), oC = tap(fp,  1,  2);

    float bL = edgeLuma(bC), cL = edgeLuma(cC);
    float eL = edgeLuma(eC), fL = edgeLuma(fC), gL = edgeLuma(gC), hL = edgeLuma(hC);
    float iL = edgeLuma(iC), jL = edgeLuma(jC), kL = edgeLuma(kC), lL = edgeLuma(lC);
    float nL = edgeLuma(nC), oL = edgeLuma(oC);

    vec2 dir = vec2(0.0);
    float len = 0.0;
    easuSet(dir, len, pp, 0, bL, eL, fL, gL, jL);
    easuSet(dir, len, pp, 1, cL, fL, gL, hL, kL);
    easuSet(dir, len, pp, 2, fL, iL, jL, kL, nL);
    easuSet(dir, len, pp, 3, gL, jL, kL, lL, oL);

    vec2 dir2 = dir * dir;
    float dirR = dir2.x + dir2.y;
    bool zero = dirR < (1.0 / 32768.0);
    dirR = zero ? 1.0 : inversesqrt(dirR);
    dir.x = zero ? 1.0 : dir.x;
    dir *= dirR;

    len = len * 0.5;
    len *= len;

    float stretch = (dir.x * dir.x + dir.y * dir.y) * safeRcp(max(abs(dir.x), abs(dir.y)));
    vec2 len2 = vec2(1.0 + (stretch - 1.0) * len,
                     1.0 - 0.5 * len);

    float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
    float clp = safeRcp(lob);

    vec3 accColor = vec3(0.0);
    float accWeight = 0.0;
    easuTap(accColor, accWeight, vec2( 0.0, -1.0) - pp, dir, len2, lob, clp, bC);
    easuTap(accColor, accWeight, vec2( 1.0, -1.0) - pp, dir, len2, lob, clp, cC);
    easuTap(accColor, accWeight, vec2(-1.0,  1.0) - pp, dir, len2, lob, clp, iC);
    easuTap(accColor, accWeight, vec2( 0.0,  1.0) - pp, dir, len2, lob, clp, jC);
    easuTap(accColor, accWeight, vec2( 0.0,  0.0) - pp, dir, len2, lob, clp, fC);
    easuTap(accColor, accWeight, vec2(-1.0,  0.0) - pp, dir, len2, lob, clp, eC);
    easuTap(accColor, accWeight, vec2( 1.0,  1.0) - pp, dir, len2, lob, clp, kC);
    easuTap(accColor, accWeight, vec2( 2.0,  1.0) - pp, dir, len2, lob, clp, lC);
    easuTap(accColor, accWeight, vec2( 2.0,  0.0) - pp, dir, len2, lob, clp, hC);
    easuTap(accColor, accWeight, vec2( 1.0,  0.0) - pp, dir, len2, lob, clp, gC);
    easuTap(accColor, accWeight, vec2( 1.0,  2.0) - pp, dir, len2, lob, clp, oC);
    easuTap(accColor, accWeight, vec2( 0.0,  2.0) - pp, dir, len2, lob, clp, nC);

    vec3 mn4 = min(min(fC, gC), min(jC, kC));
    vec3 mx4 = max(max(fC, gC), max(jC, kC));
    vec3 pix = clamp(accColor * safeRcp(accWeight), mn4, mx4);

    imageStore(dst, ivec2(gid), vec4(pix, 1.0));
}

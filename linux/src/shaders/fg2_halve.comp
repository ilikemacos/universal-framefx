#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 1) uniform sampler2D src;
layout(binding = 2, r16f) uniform writeonly image2D dst;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(dst);
    if (gid.x >= sz.x || gid.y >= sz.y) return;
    vec2 uv = (vec2(gid) + 0.5) / vec2(sz);
    float y = textureLod(src, uv, 0.0).r;
    imageStore(dst, gid, vec4(y, 0.0, 0.0, 0.0));
}

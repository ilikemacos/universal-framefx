#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform SsgiParams {
    float srcW, srcH, lightW, lightH;
    float invSrcW, invSrcH, invLightW, invLightH;
    float marchSteps, raysPerTexel, frameIndex, stepCells;
    float strength, aoStrength, emitLo, emitHi;
    float falloff, rangeK, heightScale, stepGrowth;
    float horizonBias, aoRadius, aoGame, pad;
} pc;

layout(binding = 0) uniform sampler2D gGame;
layout(std430, binding = 1) buffer Grid {
    vec4 cells[];
} grid;

float luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    uvec2 id = gl_GlobalInvocationID.xy;
    vec2 size = vec2(pc.srcW, pc.srcH);
    vec2 cellPx = size * (1.0 / 128.0);
    vec2 org = vec2(id) * cellPx;
    vec3 sum = vec3(0.0);
    for (uint i = 0u; i < 16u; ++i) {
        vec2 sub = (vec2(float(i & 3u), float(i >> 2u)) + 0.5) * 0.25;
        vec2 corner = max(floor(org + sub * cellPx + 0.5), vec2(1.0));
        corner = min(corner, size - 1.0);
        sum += textureLod(gGame, corner * vec2(pc.invSrcW, pc.invSrcH), 0.0).rgb;
    }
    vec3 avg = sum * (1.0 / 16.0);
    float b = max(luma(avg), 0.75 * max(avg.r, max(avg.g, avg.b)));
    grid.cells[id.y * 128u + id.x] = vec4(avg, b);
}
